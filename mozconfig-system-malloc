# Firefox build with no mozjemalloc and no PHC: uses the libc allocator, so an
# upstream drop-in override (DYLD_INSERT_LIBRARIES) can replace it cleanly.
# Use from the checkout root: MOZCONFIG=mozconfig-system-malloc ./mach build
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --enable-release
ac_add_options --disable-jemalloc

ac_add_options --with-ccache=sccache

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-system-malloc
