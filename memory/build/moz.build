    SOURCES += libpas_cxx_sources
    for f in libpas_c_sources:
        SOURCES[f].flags += libpas_flags
    for f in libpas_cxx_sources:
        SOURCES[f].flags += libpas_flags + ["-x", "c++", "-std=gnu++23"]
    # libpas headers include <stdatomic.h>, which libc++ only allows alongside
    # <atomic> from C++23.
    SOURCES["alt/libpas_glue.cpp"].flags += libpas_flags + ["-std=gnu++23"]
    LOCAL_INCLUDES += [
        "/memory/libpas/src/bmalloc",
        "/memory/libpas/src/libpas",
    ]
elif CONFIG["MOZ_ALT_ALLOCATOR"] == "partition_alloc":
    # The allocator_base and allocator_core targets of PartitionAlloc's
    # src/partition_alloc/BUILD.gn for this configuration (see
    # memory/partition_alloc/README-vendoring.md).
