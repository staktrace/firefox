        "/memory/gperftools/src/common.cc",
        "/memory/gperftools/src/internal_logging.cc",
        "/memory/gperftools/src/malloc_extension.cc",
        "/memory/gperftools/src/malloc_hook.cc",
        "/memory/gperftools/src/memfs_malloc.cc",
        "/memory/gperftools/src/page_heap.cc",
        "/memory/gperftools/src/safe_strerror.cc",
        "/memory/gperftools/src/sampler.cc",
        "/memory/gperftools/src/span.cc",
        "/memory/gperftools/src/stack_trace_table.cc",
        "/memory/gperftools/src/static_vars.cc",
        "/memory/gperftools/src/system-alloc.cc",
        "/memory/gperftools/src/tcmalloc.cc",
        "/memory/gperftools/src/thread_cache.cc",
        "/memory/gperftools/src/thread_cache_ptr.cc",
    ]
    SOURCES += tcmalloc_sources
    for f in tcmalloc_sources:
        SOURCES[f].flags += [
            "-DNDEBUG",
            "-DNO_TCMALLOC_SAMPLES",
            "-DTCMALLOC_SKIP_OVERRIDE",
            "-Wno-unused-parameter",
            "-Wno-unused-function",
            "-Wno-sign-compare",
        ]
    LOCAL_INCLUDES += [
        "/memory/gperftools/config",
        "/memory/gperftools/src",
    ]
elif CONFIG["MOZ_ALT_ALLOCATOR"] == "libpas":
    libpas_flags = [
        "-D_GNU_SOURCE",
        "-DPAS_BMALLOC=1",
        "-DPAS_BMALLOC_HIDDEN=1",
        "-DNDEBUG",
        "-Wno-unused-parameter",
        "-Wno-unused-function",
        "-Wno-sign-compare",
        "-Wno-missing-field-initializers",
        "-Wno-cast-align",
        # pas_lock.h uses os_unfair_lock_lock_with_flags (macOS 15+) as WebKit
        # does with the public SDK, so this build needs macOS 15 to run.
        "-Wno-error=unguarded-availability-new",
    ]
    # Compiled as C++, as WebKit's bmalloc CMakeLists does: they use
    # compound-literal field access in file-scope initializers.
    libpas_cxx_sources = [
        "/memory/libpas/src/libpas/bmalloc_heap.c",
