        "/memory/partition_alloc/src/partition_alloc/partition_alloc_base/time/time_conversion_posix.cc",
        "/memory/partition_alloc/src/partition_alloc/partition_alloc_base/time/time_override.cc",
    ]
    partition_alloc_core_sources = [
        "/memory/partition_alloc/src/partition_alloc/address_pool_manager.cc",
        "/memory/partition_alloc/src/partition_alloc/address_pool_manager_bitmap.cc",
        "/memory/partition_alloc/src/partition_alloc/address_space_randomization.cc",
        "/memory/partition_alloc/src/partition_alloc/allocation_guard.cc",
        "/memory/partition_alloc/src/partition_alloc/allocator_config.cc",
        "/memory/partition_alloc/src/partition_alloc/bounds_checks.cc",
        "/memory/partition_alloc/src/partition_alloc/compressed_pointer.cc",
        "/memory/partition_alloc/src/partition_alloc/dangling_raw_ptr_checks.cc",
        "/memory/partition_alloc/src/partition_alloc/gwp_asan_support.cc",
        "/memory/partition_alloc/src/partition_alloc/in_slot_metadata.cc",
        "/memory/partition_alloc/src/partition_alloc/intended_leak.cc",
        "/memory/partition_alloc/src/partition_alloc/internal_allocator.cc",
        "/memory/partition_alloc/src/partition_alloc/memory_reclaimer.cc",
        "/memory/partition_alloc/src/partition_alloc/oom.cc",
        "/memory/partition_alloc/src/partition_alloc/oom_callback.cc",
        "/memory/partition_alloc/src/partition_alloc/page_allocator.cc",
        "/memory/partition_alloc/src/partition_alloc/page_allocator_internals_posix.cc",
        "/memory/partition_alloc/src/partition_alloc/partition_address_space.cc",
        "/memory/partition_alloc/src/partition_alloc/partition_alloc.cc",
        "/memory/partition_alloc/src/partition_alloc/partition_alloc_hooks.cc",
        "/memory/partition_alloc/src/partition_alloc/partition_bucket.cc",
        "/memory/partition_alloc/src/partition_alloc/partition_cookie.cc",
        "/memory/partition_alloc/src/partition_alloc/partition_dcheck_helper.cc",
        "/memory/partition_alloc/src/partition_alloc/partition_freelist_entry.cc",
        "/memory/partition_alloc/src/partition_alloc/partition_oom.cc",
        "/memory/partition_alloc/src/partition_alloc/partition_page.cc",
        "/memory/partition_alloc/src/partition_alloc/partition_root.cc",
        "/memory/partition_alloc/src/partition_alloc/partition_stats.cc",
        "/memory/partition_alloc/src/partition_alloc/partition_tls.cc",
        "/memory/partition_alloc/src/partition_alloc/partition_tls_posix.cc",
        "/memory/partition_alloc/src/partition_alloc/random.cc",
        "/memory/partition_alloc/src/partition_alloc/reservation_offset_table.cc",
        "/memory/partition_alloc/src/partition_alloc/scheduler_loop_quarantine.cc",
        "/memory/partition_alloc/src/partition_alloc/scheduler_loop_quarantine_support.cc",
        "/memory/partition_alloc/src/partition_alloc/slot_address_and_size.cc",
        "/memory/partition_alloc/src/partition_alloc/slot_start.cc",
        "/memory/partition_alloc/src/partition_alloc/spinning_mutex.cc",
        "/memory/partition_alloc/src/partition_alloc/stack/asm/arm64/push_registers_asm.cc",
        "/memory/partition_alloc/src/partition_alloc/stack/stack.cc",
        "/memory/partition_alloc/src/partition_alloc/tagging.cc",
        "/memory/partition_alloc/src/partition_alloc/thread_cache.cc",
        "/memory/partition_alloc/src/partition_alloc/thread_isolation/pkey.cc",
        "/memory/partition_alloc/src/partition_alloc/thread_isolation/thread_isolation.cc",
    ]
    SOURCES += partition_alloc_base_sources
    SOURCES += partition_alloc_core_sources
    for f in partition_alloc_base_sources:
        SOURCES[f].flags += [
            "-DNDEBUG",
            "-DHAVE_DLADDR",
            "-DIS_PARTITION_ALLOC_BASE_IMPL",
        ]
        if f.endswith(".mm"):
            # Chromium builds PartitionAlloc's Objective-C++ with ARC.
            SOURCES[f].flags += ["-fobjc-arc"]
    for f in partition_alloc_core_sources:
        SOURCES[f].flags += ["-DNDEBUG", "-DIS_PARTITION_ALLOC_IMPL"]
    SOURCES["alt/partition_alloc_glue.cpp"].flags += ["-DNDEBUG"]
    OS_LIBS += [
        "-framework CoreFoundation",
        "-framework Foundation",
        "-framework Security",
    ]
    LOCAL_INCLUDES += [
        "/memory/partition_alloc/gen",
        "/memory/partition_alloc/src",
    ]
elif CONFIG["MOZ_MEMORY"] and not CONFIG["MOZ_ALT_ALLOCATOR"]:
    UNIFIED_SOURCES += [
        "BaseAlloc.cpp",
        "Chunk.cpp",
        "Globals.cpp",
        "mozjemalloc.cpp",
        "mozmemory_wrap.cpp",
        "Mutex.cpp",
        "Utils.cpp",
    ]
    SOURCE_HEADERS += [
        "BaseAlloc.h",
        "Chunk.h",
        "Globals.h",
        "mozjemalloc.h",
        "Mutex.h",
        "Utils.h",
    ]
else:
    UNIFIED_SOURCES += [
        "Fallback.cpp",
    ]

if CONFIG["OS_TARGET"] == "Darwin" and (
    CONFIG["MOZ_REPLACE_MALLOC"] or CONFIG["MOZ_MEMORY"]
):
    SOURCES += [
        "Zone.c",
    ]

SOURCE_HEADERS += [
    "Arena.h",
    "ArenaAvailRuns.h",
    "BaseAllocInternals.h",
    "BaseArray.h",
    "Constants.h",
    "Extent.h",
    "RadixTree.h",
    "RedBlackTree.h",
    "Zero.h",
]

Library("memory")

if CONFIG["OS_TARGET"] == "Android" and CONFIG["CC_TYPE"] == "clang":
    CXXFLAGS += [
        "-Wno-tautological-pointer-compare",
    ]

if CONFIG["MOZ_BUILD_APP"] != "memory":
    FINAL_LIBRARY = "mozglue"

if CONFIG["MOZ_REPLACE_MALLOC_STATIC"]:
    DEFINES["MOZ_REPLACE_MALLOC_STATIC"] = True

DisableStlWrapping()

if CONFIG["CC_TYPE"] == "clang-cl":
    AllowCompilerWarnings()  # workaround for bug 1090497

TEST_DIRS += ["test"]

if CONFIG["NIGHTLY_BUILD"]:
    DEFINES["MOZJEMALLOC_PROFILING_CALLBACKS"] = True

LICENSES += ["jemalloc"]
LICENSES["jemalloc"].title = "jemalloc License"
LICENSES["jemalloc"].text = "LICENSE-NOTICE.txt"
LICENSES["jemalloc"].spdx = "BSD-2-Clause"
LICENSES["jemalloc"].notice = """
<p>This license applies to portions of the files in the directory <code>memory/build/</code>.</p>
"""

LICENSED_UNDER += [
    "jemalloc",
]
