# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at http://mozilla.org/MPL/2.0/.

EXPORTS += [
    "malloc_decls.h",
    "mozjemalloc_profiling.h",
    "mozjemalloc_types.h",
    "mozmemory.h",
    "mozmemory_stall.h",
    "mozmemory_wrap.h",
    "PHC.h",
]

LIBRARY_DEFINES["MOZ_HAS_MOZGLUE"] = True
DEFINES["MOZ_MEMORY_IMPL"] = True

if CONFIG["MOZ_BUILD_APP"] == "memory":
    DEFINES["IMPL_MFBT"] = True

if CONFIG["MOZ_REPLACE_MALLOC"]:
    EXPORTS += [
        "replace_malloc.h",
        "replace_malloc_bridge.h",
    ]

if CONFIG["MOZ_PHC"]:
    DEFINES["MOZ_PHC"] = True
    UNIFIED_SOURCES += [
        "FdPrintf.cpp",
        # PHC.cpp is #included in mozjemalloc.cpp
    ]
    SOURCE_HEADERS += [
        "FdPrintf.h",
    ]

if CONFIG["MOZ_ALT_ALLOCATOR"]:
    SOURCES += [
        "alt/%s_glue.cpp" % CONFIG["MOZ_ALT_ALLOCATOR"],
    ]
    UNIFIED_SOURCES += [
        "mozmemory_wrap.cpp",
    ]
    SOURCE_HEADERS += [
        "alt/AltCommon.h",
    ]

if CONFIG["MOZ_ALT_ALLOCATOR"] == "rpmalloc":
    SOURCES += [
        "/memory/rpmalloc/rpmalloc.c",
    ]
    rpmalloc_flags = [
        "-DRPMALLOC_PTHREAD_TLS",
        "-DENABLE_OVERRIDE=0",
        "-DENABLE_STATISTICS=0",
        "-DENABLE_VALIDATE_ARGS=0",
        "-DENABLE_ASSERTS=0",
        "-DRPMALLOC_FIRST_CLASS_HEAPS=1",
        "-Wno-unused-function",
        "-Wno-unused-parameter",
        "-Wno-sign-compare",
    ]
    SOURCES["/memory/rpmalloc/rpmalloc.c"].flags += rpmalloc_flags
    LOCAL_INCLUDES += ["/memory/rpmalloc"]
elif CONFIG["MOZ_ALT_ALLOCATOR"] == "mimalloc":
    SOURCES += [
        "/memory/mimalloc/src/static.c",
    ]
    SOURCES["/memory/mimalloc/src/static.c"].flags += [
        "-DNDEBUG",
        "-DMI_DEBUG=0",
        "-DMI_STATS=1",
        "-DMI_PROFILE=1",
        "-Wno-unused-function",
        "-Wno-unused-parameter",
        "-Wno-sign-compare",
    ]
    LOCAL_INCLUDES += ["/memory/mimalloc/include"]
elif CONFIG["MOZ_ALT_ALLOCATOR"] == "snmalloc":
    SOURCES["alt/snmalloc_glue.cpp"].flags += [
        "-DNDEBUG",
        "-DSNMALLOC_USE_WAIT_ON_ADDRESS=1",
    ]
    LOCAL_INCLUDES += ["/memory/snmalloc/src"]
elif CONFIG["MOZ_ALT_ALLOCATOR"] == "jemalloc5":
    jemalloc5_sources = [
        "/memory/jemalloc5/src/arena.c",
        "/memory/jemalloc5/src/arenas_management.c",
        "/memory/jemalloc5/src/background_thread.c",
        "/memory/jemalloc5/src/base.c",
        "/memory/jemalloc5/src/bin.c",
        "/memory/jemalloc5/src/bin_info.c",
        "/memory/jemalloc5/src/bitmap.c",
        "/memory/jemalloc5/src/buf_writer.c",
        "/memory/jemalloc5/src/cache_bin.c",
        "/memory/jemalloc5/src/ckh.c",
        "/memory/jemalloc5/src/conf.c",
        "/memory/jemalloc5/src/counter.c",
        "/memory/jemalloc5/src/ctl.c",
        "/memory/jemalloc5/src/decay.c",
        "/memory/jemalloc5/src/div.c",
        "/memory/jemalloc5/src/ecache.c",
        "/memory/jemalloc5/src/edata.c",
        "/memory/jemalloc5/src/edata_cache.c",
        "/memory/jemalloc5/src/ehooks.c",
        "/memory/jemalloc5/src/emap.c",
        "/memory/jemalloc5/src/eset.c",
        "/memory/jemalloc5/src/exp_grow.c",
        "/memory/jemalloc5/src/extent.c",
        "/memory/jemalloc5/src/extent_dss.c",
        "/memory/jemalloc5/src/extent_mmap.c",
        "/memory/jemalloc5/src/fxp.c",
        "/memory/jemalloc5/src/hpa.c",
        "/memory/jemalloc5/src/hpa_central.c",
        "/memory/jemalloc5/src/hpa_hooks.c",
        "/memory/jemalloc5/src/hpa_utils.c",
        "/memory/jemalloc5/src/hpdata.c",
        "/memory/jemalloc5/src/inspect.c",
        "/memory/jemalloc5/src/jemalloc.c",
        "/memory/jemalloc5/src/jemalloc_fork.c",
        "/memory/jemalloc5/src/jemalloc_init.c",
        "/memory/jemalloc5/src/large.c",
        "/memory/jemalloc5/src/log.c",
        "/memory/jemalloc5/src/malloc_dispatch.c",
        "/memory/jemalloc5/src/malloc_io.c",
        "/memory/jemalloc5/src/mutex.c",
        "/memory/jemalloc5/src/nstime.c",
        "/memory/jemalloc5/src/pa.c",
        "/memory/jemalloc5/src/pa_extra.c",
        "/memory/jemalloc5/src/pac.c",
        "/memory/jemalloc5/src/pages.c",
        "/memory/jemalloc5/src/peak_event.c",
        "/memory/jemalloc5/src/percpu_arena.c",
        "/memory/jemalloc5/src/prof.c",
        "/memory/jemalloc5/src/prof_data.c",
        "/memory/jemalloc5/src/prof_log.c",
        "/memory/jemalloc5/src/prof_recent.c",
        "/memory/jemalloc5/src/prof_stats.c",
        "/memory/jemalloc5/src/prof_sys.c",
        "/memory/jemalloc5/src/psset.c",
        "/memory/jemalloc5/src/rtree.c",
        "/memory/jemalloc5/src/safety_check.c",
        "/memory/jemalloc5/src/san.c",
        "/memory/jemalloc5/src/san_bump.c",
        "/memory/jemalloc5/src/sc.c",
        "/memory/jemalloc5/src/sec.c",
        "/memory/jemalloc5/src/stats.c",
        "/memory/jemalloc5/src/sz.c",
        "/memory/jemalloc5/src/tcache.c",
        "/memory/jemalloc5/src/test_hooks.c",
        "/memory/jemalloc5/src/thread_event.c",
        "/memory/jemalloc5/src/thread_event_registry.c",
        "/memory/jemalloc5/src/ticker.c",
        "/memory/jemalloc5/src/tsd.c",
        "/memory/jemalloc5/src/util.c",
        "/memory/jemalloc5/src/witness.c",
        "alt/jemalloc5_helpers.c",
    ]
    SOURCES += jemalloc5_sources
    for f in jemalloc5_sources:
        SOURCES[f].flags += [
            "-D_REENTRANT",
            "-Wno-unused-parameter",
            "-Wno-unused-function",
            "-Wno-sign-compare",
            "-Wno-missing-field-initializers",
            "-Wno-implicit-fallthrough",
        ]
    LOCAL_INCLUDES += ["/memory/jemalloc5/include"]
elif CONFIG["MOZ_ALT_ALLOCATOR"] == "tcmalloc":
    tcmalloc_sources = [
        "/memory/gperftools/src/base/dynamic_annotations.cc",
        "/memory/gperftools/src/base/generic_writer.cc",
        "/memory/gperftools/src/base/logging.cc",
        "/memory/gperftools/src/base/proc_maps_iterator.cc",
        "/memory/gperftools/src/base/spinlock.cc",
        "/memory/gperftools/src/base/spinlock_internal.cc",
        "/memory/gperftools/src/base/sysinfo.cc",
        "/memory/gperftools/src/central_freelist.cc",
        "/memory/gperftools/src/common.cc",
        "/memory/gperftools/src/internal_logging.cc",
        "/memory/gperftools/src/malloc_extension.cc",
        "/memory/gperftools/src/malloc_hook.cc",
        "/memory/gperftools/src/memfs_malloc.cc",
        "/memory/gperftools/src/page_heap.cc",
        "/memory/gperftools/src/safe_strerror.cc",
        "/memory/gperftools/src/sampler.cc",
        "/memory/gperftools/src/span.cc",
        "/memory/gperftools/src/stack_trace_table.cc",
        "/memory/gperftools/src/static_vars.cc",
        "/memory/gperftools/src/system-alloc.cc",
        "/memory/gperftools/src/tcmalloc.cc",
        "/memory/gperftools/src/thread_cache.cc",
        "/memory/gperftools/src/thread_cache_ptr.cc",
    ]
    SOURCES += tcmalloc_sources
    for f in tcmalloc_sources:
        SOURCES[f].flags += [
            "-DNDEBUG",
            "-DNO_TCMALLOC_SAMPLES",
            "-DTCMALLOC_SKIP_OVERRIDE",
            "-Wno-unused-parameter",
            "-Wno-unused-function",
            "-Wno-sign-compare",
        ]
    LOCAL_INCLUDES += [
        "/memory/gperftools/config",
        "/memory/gperftools/src",
    ]
elif CONFIG["MOZ_MEMORY"] and not CONFIG["MOZ_ALT_ALLOCATOR"]:
    UNIFIED_SOURCES += [
        "BaseAlloc.cpp",
        "Chunk.cpp",
        "Globals.cpp",
        "mozjemalloc.cpp",
        "mozmemory_wrap.cpp",
        "Mutex.cpp",
        "Utils.cpp",
    ]
    SOURCE_HEADERS += [
        "BaseAlloc.h",
        "Chunk.h",
        "Globals.h",
        "mozjemalloc.h",
        "Mutex.h",
        "Utils.h",
    ]
else:
    UNIFIED_SOURCES += [
        "Fallback.cpp",
    ]

if CONFIG["OS_TARGET"] == "Darwin" and (
    CONFIG["MOZ_REPLACE_MALLOC"] or CONFIG["MOZ_MEMORY"]
):
    SOURCES += [
        "Zone.c",
    ]

SOURCE_HEADERS += [
    "Arena.h",
    "ArenaAvailRuns.h",
    "BaseAllocInternals.h",
    "BaseArray.h",
    "Constants.h",
    "Extent.h",
    "RadixTree.h",
    "RedBlackTree.h",
    "Zero.h",
]

Library("memory")

if CONFIG["OS_TARGET"] == "Android" and CONFIG["CC_TYPE"] == "clang":
    CXXFLAGS += [
        "-Wno-tautological-pointer-compare",
    ]

if CONFIG["MOZ_BUILD_APP"] != "memory":
    FINAL_LIBRARY = "mozglue"

if CONFIG["MOZ_REPLACE_MALLOC_STATIC"]:
    DEFINES["MOZ_REPLACE_MALLOC_STATIC"] = True

DisableStlWrapping()

if CONFIG["CC_TYPE"] == "clang-cl":
    AllowCompilerWarnings()  # workaround for bug 1090497

TEST_DIRS += ["test"]

if CONFIG["NIGHTLY_BUILD"]:
    DEFINES["MOZJEMALLOC_PROFILING_CALLBACKS"] = True

LICENSES += ["jemalloc"]
LICENSES["jemalloc"].title = "jemalloc License"
LICENSES["jemalloc"].text = "LICENSE-NOTICE.txt"
LICENSES["jemalloc"].spdx = "BSD-2-Clause"
LICENSES["jemalloc"].notice = """
<p>This license applies to portions of the files in the directory <code>memory/build/</code>.</p>
"""

LICENSED_UNDER += [
    "jemalloc",
]
