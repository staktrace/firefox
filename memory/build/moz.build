# file, You can obtain one at http://mozilla.org/MPL/2.0/.

EXPORTS += [
    "malloc_decls.h",
    "mozjemalloc_profiling.h",
    "mozjemalloc_types.h",
    "mozmemory.h",
    "mozmemory_stall.h",
    "mozmemory_wrap.h",
    "PHC.h",
]

LIBRARY_DEFINES["MOZ_HAS_MOZGLUE"] = True
DEFINES["MOZ_MEMORY_IMPL"] = True

if CONFIG["MOZ_BUILD_APP"] == "memory":
    DEFINES["IMPL_MFBT"] = True

if CONFIG["MOZ_REPLACE_MALLOC"]:
    EXPORTS += [
        "replace_malloc.h",
        "replace_malloc_bridge.h",
    ]

if CONFIG["MOZ_PHC"]:
    DEFINES["MOZ_PHC"] = True
    UNIFIED_SOURCES += [
        "FdPrintf.cpp",
        # PHC.cpp is #included in mozjemalloc.cpp
    ]
    SOURCE_HEADERS += [
        "FdPrintf.h",
    ]

if CONFIG["MOZ_ALT_ALLOCATOR"]:
    SOURCES += [
        "alt/%s_glue.cpp" % CONFIG["MOZ_ALT_ALLOCATOR"],
    ]
    UNIFIED_SOURCES += [
        "mozmemory_wrap.cpp",
    ]
    SOURCE_HEADERS += [
        "alt/AltCommon.h",
    ]

if CONFIG["MOZ_ALT_ALLOCATOR"] == "rpmalloc":
    SOURCES += [
        "/memory/rpmalloc/rpmalloc.c",
    ]
    rpmalloc_flags = [
        "-DRPMALLOC_PTHREAD_TLS",
        "-DENABLE_OVERRIDE=0",
        "-DENABLE_STATISTICS=0",
        "-DENABLE_VALIDATE_ARGS=0",
        "-DENABLE_ASSERTS=0",
        "-DRPMALLOC_FIRST_CLASS_HEAPS=1",
        "-Wno-unused-function",
        "-Wno-unused-parameter",
        "-Wno-sign-compare",
    ]
    SOURCES["/memory/rpmalloc/rpmalloc.c"].flags += rpmalloc_flags
    LOCAL_INCLUDES += ["/memory/rpmalloc"]
elif CONFIG["MOZ_ALT_ALLOCATOR"] == "mimalloc":
    SOURCES += [
        "/memory/mimalloc/src/static.c",
    ]
    SOURCES["/memory/mimalloc/src/static.c"].flags += [
        "-DNDEBUG",
        "-DMI_DEBUG=0",
        "-DMI_STATS=1",
        "-DMI_PROFILE=1",
        "-DMI_SECURE=0",
        "-DMI_GUARDED=0",
        "-DMI_PADDING=0",
        "-Wno-unused-function",
        "-Wno-unused-parameter",
        "-Wno-sign-compare",
    ]
    LOCAL_INCLUDES += ["/memory/mimalloc/include"]
elif CONFIG["MOZ_ALT_ALLOCATOR"] == "snmalloc":
    SOURCES["alt/snmalloc_glue.cpp"].flags += [
        "-DNDEBUG",
        "-DSNMALLOC_USE_WAIT_ON_ADDRESS=1",
    ]
    LOCAL_INCLUDES += ["/memory/snmalloc/src"]
elif CONFIG["MOZ_ALT_ALLOCATOR"] == "jemalloc5":
