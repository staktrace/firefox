# Memory-error probes, linked into mozglue next to the allocator so they
# exercise exactly the allocator configuration of the build. See README.md.

EXPORTS.mozilla += [
    "AllocProbes.h",
]

SOURCES += [
    "AllocProbes.c",
]

# Keep the deliberate undefined behaviour intact and leave detection to the
# allocator alone.
SOURCES["AllocProbes.c"].flags += [
    "-O1",
    "-fno-builtin",
    "-fno-strict-aliasing",
    "-fno-stack-protector",
    "-U_FORTIFY_SOURCE",
    "-D_FORTIFY_SOURCE=0",
]

DEFINES["IMPL_MFBT"] = True

Library("alloc_probes")
FINAL_LIBRARY = "mozglue"
