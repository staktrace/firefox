# Baseline Firefox with mozjemalloc, to compare against the
# --enable-alt-allocator builds (mozconfig-<allocator>).
# Use from the checkout root: MOZCONFIG=mozconfig-baseline ./mach build
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-host-opt
mk_add_options AUTOCLOBBER=1

ac_add_options --with-ccache=sccache

ac_add_options --disable-debug
ac_add_options --enable-optimize
ac_add_options --enable-release
ac_add_options --disable-phc
