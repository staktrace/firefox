# Firefox with snmalloc compiled into mozglue in place of mozjemalloc
# (allocator-alt branch). PHC and replace-malloc are implied off.
# Use from the checkout root: MOZCONFIG=mozconfig-snmalloc ./mach build
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --enable-release
ac_add_options --enable-alt-allocator=snmalloc

ac_add_options --with-ccache=sccache

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-snmalloc
mk_add_options AUTOCLOBBER=1
